*.temp
*.bak
*.orig
*~

# Credentials and local signing keys
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.jks
*.keystore
*.p12
*.pfx

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Do not ignore *.zip: the bundled Codex runtime is tracked through Git LFS.
